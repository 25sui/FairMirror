ENVIRONMENT=development
DEBUG=false

BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_DB=fairmirror
POSTGRES_USER=fairmirror
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql://fairmirror:replace-with-strong-postgres-password@postgres:5432/fairmirror
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
REACT_APP_API_URL=http://localhost:8000/api/v1

MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key